@model List<Neveria.Models.DTOs.ProductoDetalleDTO>

@{
    ViewData["Title"] = "Detalles de Producto";
    // Serializa la lista de la BD a JSON para usarla en JavaScript
    var productosJson = System.Text.Json.JsonSerializer.Serialize(Model);
}

@section Styles {
    <link rel="stylesheet" href="~/css/detalles-producto.css" />
}

<div class="detalles-wrapper">
    <div class="layout-detalles">

        <!-- COLUMNA IZQUIERDA: buscador + lista de productos -->
        <div class="col-productos">
            <h3 class="productos-titulo">🍦 Productos</h3>

            <div class="search-row">
                <input type="text" class="search-input" id="searchInput"
                       placeholder="Buscar producto..."
                       oninput="filtrarProductos()" />
                <button class="search-btn" onclick="filtrarProductos()">🔍</button>
            </div>

            <div class="productos-lista" id="productosLista"></div>
        </div>

        <!-- COLUMNA DERECHA: formulario de detalles -->
        <div class="col-detalles">
            <div class="edit-card" id="editCard">

                <!-- Estado vacío -->
                <div class="empty-state" id="emptyState">
                    <div class="empty-icon">🍨</div>
                    <p>Selecciona un producto<br>para ver sus detalles</p>
                </div>

                <!-- Formulario (oculto hasta seleccionar) -->
                <div id="formContent" style="display:none;">
                    <div class="edit-header">
                        <span id="editIcon" class="edit-icon">🍦</span>
                        <h3 id="editNombre"></h3>
                    </div>

                    <div class="form-grid">
                        <div class="form-group">
                            <label>NOMBRE DEL PRODUCTO</label>
                            <input type="text" id="inputNombre" class="freeze-field" />
                        </div>

                        <div class="form-group">
                            <label>PRECIO ($)</label>
                            <input type="number" id="inputPrecio" class="freeze-field" min="0" />
                        </div>

                        <div class="form-group full-width">
                            <label>DESCRIPCIÓN</label>
                            <textarea id="inputDesc" class="freeze-field" rows="3"></textarea>
                        </div>

                        <div class="form-group">
                            <label>CATEGORÍA</label>
                            <!-- El select se llena dinámicamente con las categorías reales -->
                            <select id="inputCategoria" class="freeze-field"></select>
                        </div>

                        <div class="form-group">
                            <label>DISPONIBILIDAD</label>
                            <select id="inputDisponible" class="freeze-field">
                                <option value="true">✅ Disponible</option>
                                <option value="false">❌ No disponible</option>
                            </select>
                        </div>

                        <div class="form-group full-width">
                            <label>STOCK ACTUAL</label>
                            <input type="number" id="inputStock" class="freeze-field" readonly />
                        </div>
                    </div>

                    <div id="alertaStock" style="display:none; color:#c0392b; font-weight:700; margin-top:8px;">
                        ⚠️ Stock bajo mínimo
                    </div>

                    <div class="btn-row">
                        <button class="btn-guardar" onclick="mostrarGuardado()">💾 Guardar cambios</button>
                        <button class="btn-cancelar" onclick="deseleccionar()">✕ Cancelar</button>
                    </div>

                    <div class="toast-msg" id="toastMsg"></div>
                </div>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <script>
        // ← Aquí está el cambio clave: datos reales de la BD, no hardcodeados
        const productos = @Html.Raw(productosJson);

        // Íconos por categoría (puedes agregar más)
        function iconoPorCategoria(cat) {
            const iconos = {
                "Cono":    "🍦",
                "Copa":    "🍨",
                "Paleta":  "🧊",
                "Sundae":  "🍫",
                "Especial":"🌈"
            };
            return iconos[cat] || "🍦";
        }

        let seleccionado = null;

        // Llena el select de categorías con las que existen en la BD
        function llenarCategorias() {
            const cats = [...new Set(productos.map(p => p.NameCategorie))];
            const sel = document.getElementById('inputCategoria');
            sel.innerHTML = cats.map(c => `<option value="${c}">${c}</option>`).join('');
        }

        function renderProductos(lista) {
            const cont = document.getElementById('productosLista');
            cont.innerHTML = lista.map(p => `
                <div class="producto-item ${seleccionado === p.TagProduct ? 'active' : ''}"
                     onclick="seleccionar(${p.TagProduct})">
                    <span class="p-icon">${iconoPorCategoria(p.NameCategorie)}</span>
                    <div class="p-info">
                        <span class="p-nombre">${p.NameProduct}</span>
                        <span class="p-precio">$${p.UnitPrice}</span>
                    </div>
                    <span class="p-cat">${p.NameCategorie}</span>
                </div>
            `).join('');
        }

        function filtrarProductos() {
            const q = document.getElementById('searchInput').value.toLowerCase();
            renderProductos(productos.filter(p =>
                p.NameProduct.toLowerCase().includes(q)
            ));
        }

        function seleccionar(id) {
            seleccionado = id;
            const p = productos.find(x => x.TagProduct === id);

            document.getElementById('emptyState').style.display  = 'none';
            document.getElementById('formContent').style.display = 'block';
            document.getElementById('editIcon').textContent      = iconoPorCategoria(p.NameCategorie);
            document.getElementById('editNombre').textContent    = p.NameProduct;
            document.getElementById('inputNombre').value         = p.NameProduct;
            document.getElementById('inputPrecio').value         = p.UnitPrice;
            document.getElementById('inputDesc').value           = p.DescriptionProduct ?? '';
            document.getElementById('inputStock').value          = p.StockQuantity;
            document.getElementById('inputCategoria').value      = p.NameCategorie;
            document.getElementById('inputDisponible').value     = p.IsActive ? 'true' : 'false';

            // Muestra alerta si stock está bajo
            document.getElementById('alertaStock').style.display = p.StockBajo ? 'block' : 'none';

            filtrarProductos();
        }

        function deseleccionar() {
            seleccionado = null;
            document.getElementById('emptyState').style.display  = 'block';
            document.getElementById('formContent').style.display = 'none';
            filtrarProductos();
        }

        function mostrarToast(msg, color) {
            const t = document.getElementById('toastMsg');
            t.textContent = msg;
            t.style.background = color;
            t.style.opacity = '1';
            t.style.transform = 'translateY(0)';
            setTimeout(() => {
                t.style.opacity = '0';
                t.style.transform = 'translateY(10px)';
            }, 2500);
        }

        function mostrarGuardado() {
            mostrarToast('✅ Cambios guardados correctamente', '#5D8A4E');
        }

        // Inicializar
        llenarCategorias();
        renderProductos(productos);

        // Si viene un producto preseleccionado desde el controlador
        @if (ViewBag.ProductoSeleccionado != null)
        {
                <text>seleccionar(@ViewBag.ProductoSeleccionado.TagProduct);</text>
        }
    </script>
}