@{
    ViewData["Title"] = "Detalles de Producto";
}

@section Styles {
    <link rel="stylesheet" href="~/css/detalles-producto.css" />
}

<div class="detalles-wrapper">
    <div class="layout-detalles">

        <!-- COLUMNA IZQUIERDA: buscador + lista de productos -->
        <div class="col-productos">
            <h3 class="productos-titulo">🍦 Productos</h3>

            <div class="search-row">
                <input type="text" class="search-input" id="searchInput"
                       placeholder="Buscar producto..."
                       oninput="filtrarProductos()" />
                <button class="search-btn" onclick="filtrarProductos()">🔍</button>
            </div>

            <div class="productos-lista" id="productosLista"></div>
        </div>

        <!-- COLUMNA DERECHA: formulario de detalles -->
        <div class="col-detalles">
            <div class="edit-card" id="editCard">

                <!-- Estado vacío -->
                <div class="empty-state" id="emptyState">
                    <div class="empty-icon">🍨</div>
                    <p>Selecciona un producto<br>para ver sus detalles</p>
                </div>

                <!-- Formulario (oculto hasta seleccionar) -->
                <div id="formContent" style="display:none;">
                    <div class="edit-header">
                        <span id="editIcon" class="edit-icon">🍦</span>
                        <h3 id="editNombre">Cono de Fresa</h3>
                    </div>

                    <div class="form-grid">
                        <div class="form-group">
                            <label>Nombre del producto</label>
                            <input type="text" id="inputNombre" class="freeze-field" />
                        </div>

                        <div class="form-group">
                            <label>Precio ($)</label>
                            <input type="number" id="inputPrecio" class="freeze-field" min="0" />
                        </div>

                        <div class="form-group full-width">
                            <label>Descripción</label>
                            <textarea id="inputDesc" class="freeze-field" rows="3"></textarea>
                        </div>

                        <div class="form-group">
                            <label>Categoría</label>
                            <select id="inputCategoria" class="freeze-field">
                                <option>Cono</option>
                                <option>Copa</option>
                                <option>Paleta</option>
                                <option>Sundae</option>
                                <option>Especial</option>
                            </select>
                        </div>

                        <div class="form-group">
                            <label>Disponibilidad</label>
                            <select id="inputDisponible" class="freeze-field">
                                <option>✅ Disponible</option>
                                <option>❌ No disponible</option>
                                <option>🔜 Temporada</option>
                            </select>
                        </div>

                        <div class="form-group full-width">
                            <label>Ingredientes principales</label>
                            <input type="text" id="inputIngredientes" class="freeze-field" />
                        </div>
                    </div>

                    <div class="btn-row">
                        <button class="btn-guardar" onclick="mostrarGuardado()">💾 Guardar cambios</button>
                        <button class="btn-cancelar" onclick="deseleccionar()">✕ Cancelar</button>
                    </div>

                    <div class="toast-msg" id="toastMsg"></div>
                </div>
            </div>
        </div>

    </div>
</div>

@section Scripts {
<script>
    const productos = [
        { id:1, icon:"🍦", nombre:"Cono de Fresa",    precio:35, desc:"Sabor fresco a fresa",       cat:"Cono",    disp:0, ing:"Leche, azúcar, fresa natural" },
        { id:2, icon:"🍨", nombre:"Copa de Vainilla",  precio:40, desc:"Cremosa y suave",            cat:"Copa",    disp:0, ing:"Leche, vainilla, crema" },
        { id:3, icon:"🍫", nombre:"Sundae Chocolate",  precio:45, desc:"Con salsa de chocolate",     cat:"Sundae",  disp:0, ing:"Leche, cacao, salsa chocolate" },
        { id:4, icon:"🥭", nombre:"Paleta de Mango",   precio:28, desc:"Tropical y refrescante",     cat:"Paleta",  disp:0, ing:"Mango, azúcar, limón" },
        { id:5, icon:"🌿", nombre:"Helado de Menta",   precio:42, desc:"Menta con chispas",          cat:"Copa",    disp:0, ing:"Leche, menta, chispas de chocolate" },
        { id:6, icon:"🌈", nombre:"Copa Rainbow",      precio:55, desc:"Varios sabores",             cat:"Especial",disp:0, ing:"Leche, colorantes naturales, varios sabores" },
    ];

    const disps = ["✅ Disponible", "❌ No disponible", "🔜 Temporada"];
    let seleccionado = null;

    function renderProductos(lista) {
        const cont = document.getElementById('productosLista');
        cont.innerHTML = lista.map(p => `
            <div class="producto-item ${seleccionado === p.id ? 'active' : ''}" onclick="seleccionar(${p.id})">
                <span class="p-icon">${p.icon}</span>
                <div class="p-info">
                    <span class="p-nombre">${p.nombre}</span>
                    <span class="p-precio">$${p.precio}</span>
                </div>
                <span class="p-cat">${p.cat}</span>
            </div>
        `).join('');
    }

    function filtrarProductos() {
        const q = document.getElementById('searchInput').value.toLowerCase();
        renderProductos(productos.filter(p => p.nombre.toLowerCase().includes(q)));
    }

    function seleccionar(id) {
        seleccionado = id;
        const p = productos.find(x => x.id === id);
        document.getElementById('emptyState').style.display  = 'none';
        document.getElementById('formContent').style.display = 'block';
        document.getElementById('editIcon').textContent      = p.icon;
        document.getElementById('editNombre').textContent    = p.nombre;
        document.getElementById('inputNombre').value         = p.nombre;
        document.getElementById('inputPrecio').value         = p.precio;
        document.getElementById('inputDesc').value           = p.desc;
        document.getElementById('inputIngredientes').value   = p.ing;
        document.getElementById('inputCategoria').value      = p.cat;
        document.getElementById('inputDisponible').value     = disps[p.disp];
        filtrarProductos();
    }

    function deseleccionar() {
        seleccionado = null;
        document.getElementById('emptyState').style.display  = 'block';
        document.getElementById('formContent').style.display = 'none';
        filtrarProductos();
    }

    function mostrarToast(msg, color) {
        const t = document.getElementById('toastMsg');
        t.textContent = msg;
        t.style.background = color;
        t.style.opacity = '1';
        t.style.transform = 'translateY(0)';
        setTimeout(() => {
            t.style.opacity = '0';
            t.style.transform = 'translateY(10px)';
        }, 2500);
    }

    function mostrarGuardado()  { mostrarToast('✅ Cambios guardados correctamente', '#5D8A4E'); }

    renderProductos(productos);
</script>
}
