@{
    ViewData["Title"] = "Registro";
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Registro - Freeze Dream 🍦</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/css/bootstrap.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Fredoka+One&family=Nunito:wght@400;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/registro.css" />
</head>
<body>

    <div class="deco-left">🍧</div>
    <div class="deco-right">🍦</div>

    <div class="registro-card">
        <div class="registro-title">👤 Nuevo usuario</div>

        @if (ViewBag.Error != null)
        {
            <div class="alert-msg">⚠️ @ViewBag.Error</div>
        }

        <form method="post" action="/Home/Registro">
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label class="form-label">Nombre completo</label>
                <input type="text" name="nombre" class="freeze-input" placeholder="Tu nombre..." required />
            </div>

            <div class="mb-3">
                <label class="form-label">Usuario</label>
                <input type="text" name="usuario" class="freeze-input" placeholder="Elige un usuario..." required />
            </div>

            <div class="mb-3">
                <label class="form-label">Correo electrónico</label>
                <input type="email" name="correo" class="freeze-input" placeholder="correo@ejemplo.com" required />
            </div>

            <div class="mb-3">
                <label class="form-label">Contraseña</label>
                <input type="password" name="contrasena" class="freeze-input" placeholder="Crea una contraseña..." required />
            </div>

            <div class="mb-4">
                <label class="form-label">Confirmar contraseña</label>
                <input type="password" name="confirmar" class="freeze-input" placeholder="Repite tu contraseña..." required />
            </div>

            <div class="d-flex flex-column gap-2">
                <button type="submit" class="btn-registrar">✅ Crear cuenta</button>
                <a href="/Home/Login" class="btn-volver">← Volver al login</a>
            </div>
        </form>
    </div>

</body>
</html>
