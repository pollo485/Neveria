    @{
    ViewData["Title"] = "Inicio";
}

@section Styles {
    <link rel="stylesheet" href="~/css/home.css" />
}

<div class="home-hero">
    <div class="hero-left">
        <div class="ice-emoji">🍨</div>
        <h1 class="brand-title">Freeze Dream</h1>
        <p class="brand-subtitle">Los helados más deliciosos de la ciudad 🍦</p>
        <a href="/Home/Productos" class="cta-btn">¡Ver productos!</a>
    </div>
    <div class="hero-right">
        <div class="hero-img-placeholder">
            🍧
        </div>
    </div>
</div>

<div class="feature-cards">
    <div class="feature-card" style="--color: #F4607A;">
        <div class="icon">🍦</div>
        <h5>Helados artesanales</h5>
        <p>Sabores únicos hechos con amor</p>
    </div>
    <div class="feature-card" style="--color: #87CEEB;">
        <div class="icon">🛒</div>
        <h5>Compra fácil</h5>
        <p>Elige y ordena en segundos</p>
    </div>
    <div class="feature-card" style="--color: #5D8A4E;">
        <div class="icon">📊</div>
        <h5>Estadísticas</h5>
        <p>Controla tus ventas al instante</p>
    </div>
    <div class="feature-card" style="--color: #F5C97A;">
        <div class="icon">⭐</div>
        <h5>Los favoritos</h5>
        <p>Sabores más populares del mes</p>
    </div>
</div>
