@model IEnumerable<Neveria.Models.dbFreezeDream.Category>

@{
    ViewData["Title"] = "Index";
}

@section Styles {
    <link rel="stylesheet" href="~/css/Categories.css" />
}

<div class="categories-wrapper">

    <div class="categories-header">
        <h2>🏷️ Categorías</h2>
        <button class="btn-nueva" data-bs-toggle="modal" data-bs-target="#modalCrear">
            ➕ Nueva categoría
        </button>
    </div>

    <div class="category-container">
        @foreach (var item in Model)
        {
            <div class="category-card">
                <div class="card-icon">🍦</div>
                <h5 class="card-nombre">@Html.DisplayFor(modelItem => item.NameCategorie)</h5>
                <p class="card-desc">@Html.DisplayFor(modelItem => item.DescriptionCategorie)</p>
                <div class="card-actions">
                    <a asp-action="Edit" asp-route-id="@item.TagCategorie" class="btn-accion btn-edit">✏️ Editar</a>
                    <a asp-action="Details" asp-route-id="@item.TagCategorie" class="btn-accion btn-details">👁️ Ver</a>
                    <a asp-action="Delete" asp-route-id="@item.TagCategorie" class="btn-accion btn-delete">🗑️ Eliminar</a>
                </div>
            </div>
        }
    </div>

</div>

<!-- MODAL Nueva Categoría -->
<div class="modal fade" id="modalCrear" tabindex="-1" aria-labelledby="modalCrearLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content freeze-modal">

            <div class="modal-header freeze-modal-header">
                <h5 class="modal-title" id="modalCrearLabel">🏷️ Nueva Categoría</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>

            <div class="modal-body">
                <form asp-action="Create" method="post" id="formCrear">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert-error"></div>

                    <div class="modal-form-group">
                        <label class="modal-label">Nombre de la categoría</label>
                        <input name="NameCategorie" type="text" class="modal-input"
                               placeholder="Ej: Cono, Copa, Paleta..." required />
                    </div>

                    <div class="modal-form-group">
                        <label class="modal-label">Descripción</label>
                        <input name="DescriptionCategorie" type="text" class="modal-input"
                               placeholder="Breve descripción..." />
                    </div>
                </form>
            </div>

            <div class="modal-footer freeze-modal-footer">
                <button type="button" class="btn-modal-cancelar" data-bs-dismiss="modal">✕ Cancelar</button>
                <button type="submit" form="formCrear" class="btn-modal-guardar">💾 Guardar</button>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
